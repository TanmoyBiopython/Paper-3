# install.packages(c("ggplot2", "dplyr", "scales", "rstatix"))
library(ggplot2)
library(dplyr)
library(scales)
library(rstatix)
set.seed(42)

# ---- Data ------------------------------------------------------------------
gbs <- c(0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.82, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535)
hc  <- c(2.26, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.48, 0.535, 0.535, 0.535, 1.37, 0.535, 0.535, 0.535, 0.82, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535)
ms  <- c(0.535, 0.535, 2.26, 0.535, 0.535, 0.535, 0.535, 3.11, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 2.08, 3.28, 3.78, 3.11, 0.535, 0.535, 6.38, 1.73, 2.08)
sle <- c(0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 10.76, 0.535, 2.62, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535, 0.535)

grp_levels <- c("HC", "GBS", "MS", "SLE")
ifn_alpha_data <- data.frame(
  Group = factor(rep(c("GBS", "HC", "MS", "SLE"), c(length(gbs), length(hc), length(ms), length(sle))), levels = grp_levels),
  IFN_alpha_pg_ml = c(gbs, hc, ms, sle)
)

grp_cols <- c(HC = "#4E79A7", GBS = "#F28E2B", MS = "#E15759", SLE = "#59A14F")

# ---- Summary ---------------------------------------------------------------
summary_tbl <- ifn_alpha_data %>%
  group_by(Group) %>%
  summarise(n = n(), median = median(IFN_alpha_pg_ml),
            Q1 = quantile(IFN_alpha_pg_ml, 0.25), Q3 = quantile(IFN_alpha_pg_ml, 0.75),
            .groups = "drop")
print(summary_tbl)

# ---- Kruskal-Wallis (overall test) -----------------------------------------
kw <- kruskal.test(IFN_alpha_pg_ml ~ Group, data = ifn_alpha_data)
kw_tbl <- data.frame(Cytokine = "IFN-alpha", N = nrow(ifn_alpha_data),
                     H = unname(kw$statistic), p_value = kw$p.value,
                     Conclusion = ifelse(kw$p.value < 0.05, "Significant", "Not significant"))
print(kw_tbl)
kw_p_txt <- ifelse(kw$p.value < 0.0001, "< 0.0001", paste0("= ", signif(kw$p.value, 2)))
kw_label <- paste0("Kruskal–Wallis: H = ", sprintf("%.3f", kw_tbl$H),
                   ", p ", kw_p_txt, ", N = ", kw_tbl$N)

# x-axis labels with n
x_labels <- setNames(paste0(summary_tbl$Group, "\n(n = ", summary_tbl$n, ")"),
                     as.character(summary_tbl$Group))

# ---- Dunn post hoc (Holm), keep significant pairs only ---------------------
dunn_sig <- ifn_alpha_data %>%
  dunn_test(IFN_alpha_pg_ml ~ Group, p.adjust.method = "holm") %>%
  filter(p.adj < 0.05)

y_top <- max(ifn_alpha_data$IFN_alpha_pg_ml)

# Bracket positions are built by hand for the log10 y-axis
brackets <- dunn_sig %>%
  mutate(x1 = match(group1, grp_levels),
         x2 = match(group2, grp_levels),
         span = abs(x2 - x1)) %>%
  arrange(span, pmin(x1, x2)) %>%
  mutate(y = y_top * 1.25 * 1.4^(row_number() - 1),
         tip = y / 1.08,
         xm = (x1 + x2) / 2,
         label = p.adj.signif)

# ---- Plot ------------------------------------------------------------------
ifn_alpha_plot <- ggplot(ifn_alpha_data, aes(x = Group, y = IFN_alpha_pg_ml, fill = Group)) +
  geom_violin(trim = TRUE, scale = "width", width = 0.9, alpha = 0.30, color = NA) +
  geom_boxplot(width = 0.22, outlier.shape = NA, fill = "white", alpha = 0.9,
               color = "black", linewidth = 0.7) +
  geom_point(position = position_jitter(width = 0.09, height = 0, seed = 42),
             shape = 21, color = "white", stroke = 0.6, size = 3, alpha = 0.95,
             show.legend = FALSE) +
  scale_fill_manual(values = grp_cols) +
  scale_x_discrete(labels = x_labels) +
  scale_y_log10(breaks = c(0.2, 0.5, 1, 3, 10),
                labels = label_comma(),
                expand = expansion(mult = c(0.03, 0.10))) +
  coord_cartesian(clip = "off") +
  labs(title = "Serum IFN-alpha levels across groups",
       subtitle = paste0(kw_label, "\nDunn post hoc test, Holm-adjusted"),
       x = NULL, y = "IFN-alpha concentration (pg/mL, log scale)") +
  theme_classic(base_size = 16) +
  theme(legend.position = "none",
        plot.title = element_text(size = 22, face = "bold", hjust = 0.5),
        plot.subtitle = element_text(size = 12, hjust = 0.5, color = "grey30", lineheight = 1.2,
                                     margin = margin(b = 12)),
        axis.title.y = element_text(size = 16, margin = margin(r = 10)),
        axis.text = element_text(size = 14, color = "black"),
        axis.line = element_line(linewidth = 0.9),
        axis.ticks = element_line(linewidth = 0.9),
        panel.grid.major.y = element_line(color = "grey90", linewidth = 0.4),
        plot.margin = margin(15, 25, 15, 15))

if (nrow(brackets) > 0) {
  ifn_alpha_plot <- ifn_alpha_plot +
    geom_segment(data = brackets, aes(x = x1, xend = x2, y = y, yend = y),
                 inherit.aes = FALSE, linewidth = 0.7) +
    geom_segment(data = brackets, aes(x = x1, xend = x1, y = tip, yend = y),
                 inherit.aes = FALSE, linewidth = 0.7) +
    geom_segment(data = brackets, aes(x = x2, xend = x2, y = tip, yend = y),
                 inherit.aes = FALSE, linewidth = 0.7) +
    geom_text(data = brackets, aes(x = xm, y = y, label = label),
              inherit.aes = FALSE, vjust = 0.15, size = 7)
}

print(ifn_alpha_plot)

ggsave("IFN_alpha_violin_boxplot_jitter_significance.png", ifn_alpha_plot,
       width = 8, height = 7, dpi = 300, bg = "white")
ggsave("IFN_alpha_violin_boxplot_jitter_significance.jpg", ifn_alpha_plot,
       width = 8, height = 7, dpi = 300, bg = "white")
